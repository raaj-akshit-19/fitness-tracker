# Raft's settings. Copy this file to .env (which is never committed) and
# replace the placeholders. On Render, set the same names in the service's
# Environment page instead. See README.md.

# The Supabase project's URL and its public anon key, from the project's
# Settings > API page. Only these two are needed. The service-role key is
# never used by Raft: do not put it here or anywhere else in this project.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional.
# RAFT_ALLOWED_HOSTS=raft.example.com    host names Raft is served at (Render's own is added for you)
# RAFT_TRUST_PROXY=1                     behind a proxy that sets X-Forwarded-* (Render does)
# RAFT_COOKIE_SECURE=1                   session cookies over HTTPS only (default: when the request is HTTPS)
# PORT=5000                              where to listen when run with python -m backend.app
